# OpsCat configuration — copy to .env and fill in. Never commit .env.
# --- required ---
OPSCAT_DOMAIN=localhost                  # your domain; Caddy auto-provisions TLS
OPSCAT_BASE_URL=http://localhost         # public base URL (https://<domain> in prod)
OPSCAT_SECRET=                           # long random string (cookies/crypto); generate once
OPSCAT_ADMIN_EMAIL=                      # first admin user, seeded on first boot

# --- optional: e-mail via Resend (alerts + magic-link login) ---
RESEND_API_KEY=
OPSCAT_ALERT_FROM=
OPSCAT_AUTH_FROM=

# --- optional: build identity reported by /api/version ---
# Normally left empty: the image stamps itself at build time, and that stamp wins
# over anything here (a value in .env would outlive every rebuild). Pass the commit
# to the BUILD instead, where it belongs:
#   OPSCAT_COMMIT=$(git rev-parse --short=7 HEAD) docker compose up -d --build
# OPSCAT_COMMIT=
# OPSCAT_BUILD_INFO=                     # path to build-info.json, if not in the image

# --- optional: label for the built-in probe location ---
OPSCAT_PROBE_CITY=Local
OPSCAT_PROBE_CC=XX

# --- optional: GitHub login (community feature) ---
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
# Authorization callback URL: <OPSCAT_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- PostgreSQL (docs/POSTGRES-MIGRATION-PLAN.md) -----------------------------
# The db service is OPT-IN: `docker compose --profile postgres up -d db`. A plain
# `up` does not start it, so setting these is only needed once you opt in.
# Unused by the app until Phase 5 wires the adapter.
POSTGRES_DB=opscat
POSTGRES_USER=opscat
POSTGRES_PASSWORD=                       # required by the db service; generate one
DATABASE_URL=                            # postgres://opscat:<password>@db:5432/opscat
